[Unit]
Description=chemoqbit: alpha-synuclein 47-56 zipper, A53T familial Parkinson mutation (resumable)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=2 PYSCF_MAX_MEMORY=10000
MemoryMax=14G
TimeoutStartSec=infinity
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py zipper_asyn47
ExecStartPre=/bin/sh -c '/home/deploy/dev/chemoqbit/scripts/wait_units.sh chemoqbit-abstraction chemoqbit-prolyl chemoqbit-cftr chemoqbit-ache chemoqbit-zip-sod1 chemoqbit-zip-sod1ct; echo "=== $(date "+%%F %%T")  start: zipper asyn47"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/zipper_scan.py asyn47
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_zip_asyn47.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_zip_asyn47.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
