[Unit]
Description=chemoqbit: SOD1 30-35 zipper, ALS (Charcot disease) (resumable)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=4 PYSCF_MAX_MEMORY=10000
MemoryMax=14G
TimeoutStartSec=infinity
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py zipper_sod1
ExecStartPre=/bin/sh -c '/home/deploy/dev/chemoqbit/scripts/wait_units.sh chemoqbit-abstraction chemoqbit-prolyl chemoqbit-cftr chemoqbit-ache; echo "=== $(date "+%%F %%T")  start: zipper sod1"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/zipper_scan.py sod1
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_zip_sod1.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_zip_sod1.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
