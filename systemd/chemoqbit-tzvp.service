[Unit]
Description=chemoqbit: def2-TZVP DFT single points (resumable; skipped once complete)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=4
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py tzvp
ExecStartPre=/bin/sh -c 'echo "=== $(date "+%%F %%T")  start: stages dft --basis def2-tzvp (OMP_NUM_THREADS=4)"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/ts_cluster_nuc.py --stages dft --basis def2-tzvp
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_tzvp.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_tzvp.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
