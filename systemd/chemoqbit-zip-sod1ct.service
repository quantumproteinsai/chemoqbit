[Unit]
Description=chemoqbit: SOD1 147-153 C-terminal amyloid segment, ALS (resumable)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=2 PYSCF_MAX_MEMORY=10000
MemoryMax=14G
TimeoutStartSec=infinity
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py zipper_sod1ct
ExecStartPre=/bin/sh -c '/home/deploy/dev/chemoqbit/scripts/wait_units.sh chemoqbit-abstraction chemoqbit-prolyl chemoqbit-cftr chemoqbit-ache chemoqbit-zip-asyn47 chemoqbit-zip-tau chemoqbit-zip-nacore chemoqbit-zip-sod1; echo "=== $(date "+%%F %%T")  start: zipper sod1ct"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/zipper_scan.py sod1ct
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_zip_sod1ct.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_zip_sod1ct.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
