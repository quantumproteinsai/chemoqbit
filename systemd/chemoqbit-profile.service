[Unit]
Description=chemoqbit: wB97X-D3 barrier profile along the xTB path (resumable; skipped once complete)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=4 PYSCF_MAX_MEMORY=6000
MemoryMax=10G
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py profile
ExecStartPre=/bin/sh -c 'echo "=== $(date "+%%F %%T")  start: profile check (OMP_NUM_THREADS=4)"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/ts_profile_check.py
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_profile.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_profile.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
