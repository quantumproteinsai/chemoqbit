[Unit]
Description=chemoqbit: cftr pocket, DFT cross-check of the interaction energy (resumable)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=3 PYSCF_MAX_MEMORY=12000
MemoryMax=16G
TimeoutStartSec=infinity
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py pocket_cftr_dft
ExecStartPre=/bin/sh -c '/home/deploy/dev/chemoqbit/scripts/wait_units.sh chemoqbit-abstraction chemoqbit-prolyl chemoqbit-cftr chemoqbit-ache chemoqbit-zip-sod1 chemoqbit-zip-sod1ct chemoqbit-zip-asyn47 chemoqbit-zip-tau chemoqbit-zip-nacore; echo "=== $(date "+%%F %%T")  start: cftr DFT"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/pocket_scan.py cftr dft
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_pocket_cftr.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_pocket_cftr.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
