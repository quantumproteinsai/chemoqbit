[Unit]
Description=chemoqbit: C5 proton abstraction, dUMP vs FdUMP (resumable; skipped once complete)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=4 PYSCF_MAX_MEMORY=12000
MemoryMax=18G
TimeoutStartSec=infinity
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py abstraction
ExecStartPre=/bin/sh -c '/home/deploy/dev/chemoqbit/scripts/wait_units.sh chemoqbit-tzvp chemoqbit-qmsize; echo "=== $(date "+%%F %%T")  start: C5 proton abstraction, dUMP vs FdUMP"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/ts_abstraction.py
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_abstraction.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_abstraction.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
