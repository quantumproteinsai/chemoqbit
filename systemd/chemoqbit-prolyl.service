[Unit]
Description=chemoqbit: prolyl cis/trans isomerisation and the effect of phosphorylation (resumable)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=2 PYSCF_MAX_MEMORY=8000
MemoryMax=10G
TimeoutStartSec=infinity
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py prolyl
ExecStartPre=/bin/sh -c 'echo "=== $(date "+%%F %%T")  start: prolyl isomerisation"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/prolyl_scan.py
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_prolyl.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_prolyl.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
