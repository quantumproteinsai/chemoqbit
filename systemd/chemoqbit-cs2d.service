[Unit]
Description=chemoqbit: 2D surface in the hydride coordinate and the C6-S distance (resumable; skipped once complete)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=4 PYSCF_MAX_MEMORY=4000
MemoryMax=8G
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py cs2d
ExecStartPre=/bin/sh -c 'echo "=== $(date "+%%F %%T")  start: 2D xi x C6-S surface"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/ts_cs2d.py
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_cs2d.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_cs2d.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
