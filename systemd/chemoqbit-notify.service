[Unit]
Description=chemoqbit: mail step completions of the def2-TZVP and functional-check jobs
Wants=chemoqbit-tzvp.service chemoqbit-xc.service
After=chemoqbit-tzvp.service chemoqbit-xc.service

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py any
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/notify_watch.py --to bartmercier@gmail.com --watch tzvp:results/service_tzvp.log:chemoqbit-tzvp --watch xc:results/service_xc.log:chemoqbit-xc
StandardOutput=append:/home/deploy/dev/chemoqbit/results/notify_watch.log
StandardError=append:/home/deploy/dev/chemoqbit/results/notify_watch.log

[Install]
WantedBy=default.target
