[Unit]
Description=chemoqbit: mail step completions of the running NUC jobs
Wants=chemoqbit-profile.service
After=chemoqbit-profile.service

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py profile
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/notify_watch.py --to bartmercier@gmail.com --watch profile:results/service_profile.log:chemoqbit-profile
StandardOutput=append:/home/deploy/dev/chemoqbit/results/notify_watch.log
StandardError=append:/home/deploy/dev/chemoqbit/results/notify_watch.log

[Install]
WantedBy=default.target
