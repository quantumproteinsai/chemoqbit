[Unit]
Description=chemoqbit: mail step completions of the running NUC jobs

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
MemoryMax=1G
TimeoutStartSec=infinity
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/notify_watch.py --to bartmercier@gmail.com \
  --watch abstraction:results/service_abstraction.log:chemoqbit-abstraction \
  --watch prolyl:results/service_prolyl.log:chemoqbit-prolyl \
  --watch cftr:results/service_pocket_cftr.log:chemoqbit-cftr \
  --watch ache:results/service_pocket_ache.log:chemoqbit-ache \
  --watch zipper-asyn47:results/service_zip_asyn47.log:chemoqbit-zip-asyn47
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_notify.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_notify.log
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
