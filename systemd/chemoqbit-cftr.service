[Unit]
Description=chemoqbit: lumacaftor's CFTR pocket (cystic fibrosis), alanine scan (resumable)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=2 PYSCF_MAX_MEMORY=10000
MemoryMax=14G
TimeoutStartSec=infinity
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py pocket_cftr
ExecStartPre=/bin/sh -c '/home/deploy/dev/chemoqbit/scripts/wait_units.sh chemoqbit-abstraction chemoqbit-prolyl; echo "=== $(date "+%%F %%T")  start: cftr pocket"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/pocket_scan.py cftr
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_pocket_cftr.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_pocket_cftr.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
