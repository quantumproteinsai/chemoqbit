[Unit]
Description=chemoqbit: donepezil's acetylcholinesterase pocket (Alzheimer's), alanine scan (resumable)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=2 PYSCF_MAX_MEMORY=10000
MemoryMax=14G
TimeoutStartSec=infinity
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py pocket_ache
ExecStartPre=/bin/sh -c '/home/deploy/dev/chemoqbit/scripts/wait_units.sh chemoqbit-abstraction chemoqbit-prolyl chemoqbit-cftr; echo "=== $(date "+%%F %%T")  start: ache pocket"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/pocket_scan.py ache wt scan
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_pocket_ache.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_pocket_ache.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
