[Unit]
Description=chemoqbit: convergence of the ONIOM barrier with the high-level region size (resumable; skipped once complete)
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/deploy/dev/chemoqbit
Environment=OMP_NUM_THREADS=4 PYSCF_MAX_MEMORY=12000
MemoryMax=18G
TimeoutStartSec=infinity
ExecCondition=/home/deploy/dev/chemoqbit/.venv/bin/python /home/deploy/dev/chemoqbit/scripts/nuc_todo.py qmsize
ExecStartPre=/bin/sh -c '/home/deploy/dev/chemoqbit/scripts/wait_units.sh chemoqbit-cs2d chemoqbit-o4h; echo "=== $(date "+%%F %%T")  start: QM-region size test"'
ExecStart=/home/deploy/dev/chemoqbit/.venv/bin/python -u /home/deploy/dev/chemoqbit/scripts/ts_qmsize.py default
StandardOutput=append:/home/deploy/dev/chemoqbit/results/service_qmsize.log
StandardError=append:/home/deploy/dev/chemoqbit/results/service_qmsize.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=default.target
